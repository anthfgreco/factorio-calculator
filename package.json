{
  "name": "factorio-calculator",
  "version": "2.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open /calc.html",
    "doctor": "node scripts/doctor.mjs",
    "bench": "node scripts/bench-solver.mjs",
    "bench:check": "node scripts/bench-solver.mjs --check",
    "build": "pnpm verify",
    "build:site": "vite build",
    "check": "pnpm check:quick && pnpm test:core && pnpm test:ui && pnpm validate:runtime",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:type-debt": "node scripts/check-type-debt.mjs",
    "check:quick": "pnpm check:architecture && pnpm check:type-debt && pnpm typecheck",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "preview": "vite preview --open /calc.html",
    "test": "node scripts/run-tests.mjs",
    "test:core": "node scripts/run-tests.mjs core",
    "test:ui": "node scripts/run-tests.mjs ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.playwright.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "validate:runtime": "node scripts/validate-runtime.mjs",
    "validate:build": "node scripts/validate-build.mjs && node scripts/check-build-budgets.mjs",
    "verify": "pnpm run doctor && pnpm check:quick && pnpm test:core && pnpm test:ui && pnpm bench:check && pnpm build:site && pnpm validate:runtime && pnpm validate:build",
    "zip": "zx ./zip.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "big-integer": "^1.6.52",
    "d3": "^7.9.0",
    "pako": "^3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tippy.js": "6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/d3": "^7.4.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": "22.22.3"
  },
  "packageManager": "pnpm@11.15.1"
}
