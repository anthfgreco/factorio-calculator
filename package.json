{
  "name": "factorio-calculator",
  "version": "2.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open /calc.html",
    "build": "pnpm check && pnpm build:site && pnpm validate:build",
    "build:site": "vite build",
    "check": "pnpm check:architecture && pnpm typecheck:core && pnpm typecheck && pnpm test && pnpm validate:runtime",
    "check:architecture": "node scripts/check-architecture.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "preview": "vite preview --open /calc.html",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "validate:runtime": "node scripts/validate-runtime.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "verify": "pnpm build",
    "zip": "zx ./zip.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "big-integer": "^1.6.52",
    "d3": "^7.9.0",
    "pako": "^3.0.1",
    "tippy.js": "6.3.7"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "26.1.1",
    "oxfmt": "0.61.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.15.1"
}
